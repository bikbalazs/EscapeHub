@model IReadOnlyList<BookingDto>
@{ ViewData["Title"] = "Foglalásaim"; }
<p class="eyebrow">A következő kalandod</p><h1>Foglalásaim</h1>
@if (Model.Count == 0) { <section class="empty-state"><h3>Még nincs foglalásod</h3><p>Nézz körül a szobák között, és válassz egy időpontot!</p><a class="button" asp-action="Index">Szobák böngészése</a></section> }
else { <div class="booking-list">@foreach (var booking in Model) { var active = booking.CancelledAtUtc is null; <article class="booking-card"><div><p class="eyebrow">@HungarianTime.FromUtc(booking.StartsAtUtc).ToString("yyyy. MMMM d. · HH:mm", System.Globalization.CultureInfo.GetCultureInfo("hu-HU"))</p><h3>@booking.RoomName</h3><span class="@(active ? "status-active" : "status-cancelled")">@(active ? "Aktív foglalás" : "Lemondva")</span></div>@if (active) { <form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@booking.Id"/><button class="button secondary">Foglalás lemondása</button></form> }</article> }</div> }
